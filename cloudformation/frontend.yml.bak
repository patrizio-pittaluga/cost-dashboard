AWSTemplateFormatVersion: '2010-09-09'
Description: >-
  Moneta - frontend CloudFront pay-as-you-go, S3 privato, senza WAF.
  DEPLOY SOLO IN us-east-1. Il dominio personalizzato e opzionale.

Parameters:
  CustomDomainName:
    Type: String
    Default: ''
    AllowedPattern: '^$|^moneta\.ilsitodipatrizio\.com$'
    Description: 'Alias HTTPS CloudFront (lascia vuoto per il solo dominio AWS)'
  CustomCertificateArn:
    Type: String
    Default: ''
    AllowedPattern: '^$|^arn:aws:acm:us-east-1:[0-9]{12}:certificate/[0-9a-fA-F-]+$'
    Description: 'ARN del certificato ACM ISSUED in us-east-1 per CustomDomainName'
Rules:
  DomainAndCertificateTogether:
    Assertions:
      - Assert: !Or
          - !And
              - !Equals [!Ref CustomDomainName, '']
              - !Equals [!Ref CustomCertificateArn, '']
          - !And
              - !Not [!Equals [!Ref CustomDomainName, '']]
              - !Not [!Equals [!Ref CustomCertificateArn, '']]
        AssertDescription: 'Indica sia CustomDomainName sia CustomCertificateArn oppure nessuno dei due.'
Conditions:
  HasCustomDomain: !Not [!Equals [!Ref CustomDomainName, '']]

Resources:
  WebBucket:
    Type: AWS::S3::Bucket
    DeletionPolicy: Retain
    UpdateReplacePolicy: Retain
    Properties:
      PublicAccessBlockConfiguration:
        BlockPublicAcls: true
        BlockPublicPolicy: true
        IgnorePublicAcls: true
        RestrictPublicBuckets: true
      BucketEncryption:
        ServerSideEncryptionConfiguration:
          - ServerSideEncryptionByDefault:
              SSEAlgorithm: AES256
      OwnershipControls:
        Rules:
          - ObjectOwnership: BucketOwnerEnforced

  WebOAC:
    Type: AWS::CloudFront::OriginAccessControl
    Properties:
      OriginAccessControlConfig:
        Name: !Sub '${AWS::StackName}-oac'
        Description: 'Accesso firmato CloudFront verso il bucket privato'
        OriginAccessControlOriginType: s3
        SigningBehavior: always
        SigningProtocol: sigv4

  Distribution:
    Type: AWS::CloudFront::Distribution
    Properties:
      DistributionConfig:
        Comment: !Sub 'Moneta - ${AWS::StackName} - frontend S3 privato'
        Enabled: true
        IPV6Enabled: true
        HttpVersion: http2
        DefaultRootObject: index.html
        Aliases: !If
          - HasCustomDomain
          - [!Ref CustomDomainName]
          - !Ref 'AWS::NoValue' 
        Origins:
          - Id: s3-private
            DomainName: !GetAtt WebBucket.RegionalDomainName
            OriginAccessControlId: !GetAtt WebOAC.Id
            S3OriginConfig:
              OriginAccessIdentity: ''
        DefaultCacheBehavior:
          TargetOriginId: s3-private
          ViewerProtocolPolicy: redirect-to-https
          AllowedMethods: [GET, HEAD]
          CachedMethods: [GET, HEAD]
          Compress: true
          # AWS managed CachingOptimized.
          CachePolicyId: 658327ea-f89d-4fab-a63d-7e88639e58f6
        CacheBehaviors:
          - PathPattern: config.json
            TargetOriginId: s3-private
            ViewerProtocolPolicy: redirect-to-https
            AllowedMethods: [GET, HEAD]
            CachedMethods: [GET, HEAD]
            Compress: true
            # Managed CachingDisabled: mai mantenere una configurazione obsoleta.
            CachePolicyId: 4135ea2d-6df8-44a3-9df3-4b5a84be39ad
        ViewerCertificate: !If
          - HasCustomDomain
          - AcmCertificateArn: !Ref CustomCertificateArn
            SslSupportMethod: sni-only
            MinimumProtocolVersion: TLSv1.2_2021
          - CloudFrontDefaultCertificate: true
        PriceClass: PriceClass_100

  BucketPolicy:
    Type: AWS::S3::BucketPolicy
    Properties:
      Bucket: !Ref WebBucket
      PolicyDocument:
        Version: '2012-10-17'
        Statement:
          - Sid: OnlyDistributionCanRead
            Effect: Allow
            Principal:
              Service: cloudfront.amazonaws.com
            Action: 's3:GetObject'
            Resource: !Sub '${WebBucket.Arn}/*'
            Condition:
              StringEquals:
                'AWS:SourceArn': !Sub 'arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}'

Outputs:
  WebUrl:
    Description: URL principale del sito
    Value: !If
      - HasCustomDomain
      - !Sub 'https://${CustomDomainName}/'
      - !Sub 'https://${Distribution.DomainName}/'
  CloudFrontDomain:
    Description: Dominio da passare al parametro CloudFrontDomain dello stack backend
    Value: !GetAtt Distribution.DomainName
  BucketName:
    Value: !Ref WebBucket
  DistributionId:
    Value: !Ref Distribution
